#!/usr/bin/env bash
# One-time (or refresh) AnkiWeb login for headless sync.
#
# Prompts for your AnkiWeb email + password on this terminal. The password
# is never written to disk — only the resulting sync token (hkey) is saved,
# to ~/.config/anki-headless/auth.json (mode 600). Re-run this if pull/push
# later fail with an auth error.
set -euo pipefail
SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
REPO_ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"
PYTHON="${ANKI_HEADLESS_PYTHON:-${REPO_ROOT}/.venv-headless/bin/python3}"

if [[ ! -x "${PYTHON}" ]]; then
  echo "Headless Anki venv not found at ${PYTHON}." >&2
  echo "Set up with: python3 -m venv .venv-headless && .venv-headless/bin/pip install anki==25.9.5" >&2
  exit 1
fi

cd "${REPO_ROOT}"
exec "${PYTHON}" -m anki_headless.cli login
